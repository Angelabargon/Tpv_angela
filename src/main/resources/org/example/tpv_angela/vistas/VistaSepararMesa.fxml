<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="separar-container" stylesheets="@../estilo/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.tpv_angela.controladores.camarero.ControladorSepararMesa">
    <padding>
        <Insets bottom="24" left="24" right="24" top="24" />
    </padding>
    <children>
        <Label styleClass="separar-title" text="Separar cuenta" />

        <ListView fx:id="listaItems" prefHeight="320" styleClass="separar-list" VBox.vgrow="ALWAYS" />

        <HBox alignment="CENTER_RIGHT" spacing="12">
            <children>
                <TextField fx:id="txtEfectivoRecibido" promptText="Efectivo recibido" styleClass="separar-input" />
                <Button onAction="#handlePagoEfectivo" prefHeight="58" styleClass="separar-action-button" text="EFECTIVO" />
                <Button onAction="#handlePagoTarjeta" prefHeight="58" styleClass="separar-secondary-button" text="TARJETA" />
                <Button onAction="#handleCancelar" prefHeight="48" styleClass="separar-cancel-button" text="Cancelar" />
            </children>
        </HBox>
    </children>
</VBox>
