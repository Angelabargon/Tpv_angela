<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootAlerta" alignment="CENTER" minWidth="460" prefWidth="520" spacing="18" styleClass="alerta-contenedor" stylesheets="@../estilo/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.tpv_angela.ControladorAlertas">
    <children>
        <Label fx:id="lblTitulo" maxWidth="Infinity" styleClass="alerta-titulo" text="ERROR" wrapText="true" />
        <Label fx:id="lblMensaje" maxWidth="Infinity" styleClass="alerta-mensaje" text="Aqui va el error" textAlignment="CENTER" wrapText="true" />
        <Button fx:id="btnAccion" maxWidth="Infinity" onAction="#cerrarAlerta" prefHeight="48" styleClass="alerta-boton" text="ENTENDIDO" />
    </children>
</VBox>
