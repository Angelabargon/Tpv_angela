<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="1080.0" prefWidth="1920.0" styleClass="main-container" stylesheets="@../estilo/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.tpv_angela.controladores.ControladorPantallaInicio">
    <children>
        <ImageView opacity="0.3" pickOnBounds="true" preserveRatio="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <image>
                <Image url="@../imagenes/fondo.png" />
            </image>
        </ImageView>

        <ImageView fitHeight="369.0" fitWidth="402.0" layoutX="254.0" layoutY="336.0" preserveRatio="true">
            <image>
                <Image url="@../imagenes/logo.png" />
            </image>
        </ImageView>

        <VBox alignment="CENTER_LEFT" layoutX="695.0" layoutY="336.0" prefWidth="1100.0" spacing="50.0">
            <children>
                <Label prefWidth="993.0" styleClass="welcome-label" text="Bienvenido al sistema HostelHub" wrapText="true" />
                <HBox prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <Button alignment="CENTER" contentDisplay="CENTER" onAction="#irALogin" prefHeight="110.0" prefWidth="409.0" styleClass="main-button" text="ADMINISTRADOR" textAlignment="CENTER" />
                        <Button alignment="CENTER" contentDisplay="CENTER" onAction="#irACamarero" prefHeight="100.0" prefWidth="350.0" styleClass="main-button" text="CAMARERO" textAlignment="CENTER" />
                        <Button alignment="CENTER" contentDisplay="CENTER" onAction="#irACocinero" prefHeight="100.0" prefWidth="358.0" styleClass="main-button" text="COCINERO" textAlignment="CENTER" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
