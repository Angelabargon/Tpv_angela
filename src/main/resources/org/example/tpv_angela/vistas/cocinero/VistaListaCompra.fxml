<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="ventas-container" stylesheets="@../../estilo/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.tpv_angela.controladores.cocinero.ControladorListaCompra">
    <padding>
        <Insets bottom="120" left="20" right="20" top="20" />
    </padding>
    <top>
        <VBox spacing="12.0" styleClass="panel-padding-24">
            <children>
                <Label styleClass="section-title" text="Lista de la compra" />
                <HBox spacing="10">
                    <children>
                        <TextField fx:id="txtIngrediente" promptText="Ingrediente" styleClass="input-field" />
                        <TextField fx:id="txtCantidad" promptText="Cantidad" styleClass="input-field" />
                    </children>
                </HBox>
                <HBox spacing="10">
                    <children>
                        <Button onAction="#agregarIngrediente" styleClass="login-button" text="Añadir al borrador" />
                        <Button onAction="#enviarLista" styleClass="logout-button" text="Enviar al administrador" />
                        <Button onAction="#refrescar" styleClass="logout-button" text="Refrescar" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <HBox spacing="20.0" styleClass="panel-padding-lista">
            <children>
                <VBox spacing="8.0" styleClass="lista-compra-panel" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="lista-compra-title" text="Borrador" />
                        <ListView fx:id="listaBorrador" styleClass="lista-compra-view" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
                <VBox spacing="8.0" styleClass="lista-compra-panel" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="lista-compra-title" text="Enviado" />
                        <ListView fx:id="listaEnviada" styleClass="lista-compra-view" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
                <VBox spacing="8.0" styleClass="lista-compra-panel" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="lista-compra-title" text="Comprado" />
                        <ListView fx:id="listaComprada" styleClass="lista-compra-view" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
    <bottom>
        <Label fx:id="lblEstado" styleClass="estado-padding-lista lista-compra-estado" text="Estado" />
    </bottom>
</BorderPane>
